# Netlify headers.
#
# Two kinds of asset live under /assets/. Photographs, fonts, audio and video
# carry their size or date in the file name, so a changed file is a new name and
# a year-long immutable cache is safe. site.css and site.js do not: their names
# are stable and their contents change, so they get an hour and a revalidation.
# Without that split, editing the stylesheet would leave returning visitors on a
# year-old copy.

# Everything, unless a more specific rule below overrides it. Without this,
# directory URLs such as /trails/ match no pattern at all: they are not "/" and
# they do not end in .html.
/*
  Cache-Control: public, max-age=300, must-revalidate
  # Security headers, the same everywhere (docs/SECURITY.md). The Content Security Policy
  # itself is a <meta> tag in each page, so the editor can carry a looser one than the site;
  # only frame-ancestors, which a <meta> tag cannot set, is sent here.
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=(), payment=(), usb=(), autoplay=(self "https://www.youtube-nocookie.com"), fullscreen=(self "https://www.youtube-nocookie.com"), encrypted-media=(self "https://www.youtube-nocookie.com"), picture-in-picture=(self "https://www.youtube-nocookie.com")
  Strict-Transport-Security: max-age=31536000

/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

/assets/audio/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/data/*
  Cache-Control: public, max-age=86400

/*.html
  Cache-Control: public, max-age=300, must-revalidate

/
  Cache-Control: public, max-age=300, must-revalidate

/sitemap.xml
  Cache-Control: public, max-age=3600
