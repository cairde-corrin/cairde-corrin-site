<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="Cáirde Corrin" xmlns="http://www.topografix.com/GPX/1/1">
  <metadata>
    <name>Glenabo loop</name>
    <desc>The Glenabo loop as walked by Cáirde Corrin with a phone GPS on 29 August 2026, with the stretches where the walk doubled back removed. About 2.3 km. Positions are good to roughly 10-20 m. Track elevations are the walk's own GPS elevations; waypoint elevations are the site's published figures, to the nearest 5 m. Not a waymarked route: https://www.cairdecorrin.ie/terms/</desc>
    <link href="https://www.cairdecorrin.ie/trails/"><text>Cáirde Corrin - Trails</text></link>
  </metadata>
