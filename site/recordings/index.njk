{#- The page's title, summary and structured data come from its "About this page" fields
    in the editor (site/_data/pages/recordings.json); its content from its blocks (_includes/blocks.js). -#}
{%- set P = pages.recordings.page -%}{%- set T = P.title + " - Cáirde Corrin" -%}
<!DOCTYPE html>
<html lang="en-IE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ T }}</title>
<meta name="description" content="{{ P.description }}">
<link rel="canonical" href="https://www.cairdecorrin.ie/recordings/">
<meta property="og:title" content="{{ T }}"><meta property="og:description" content="{{ P.description }}">
<meta property="og:type" content="website"><meta property="og:url" content="https://www.cairdecorrin.ie/recordings/">
<link rel="icon" type="image/png" sizes="32x32" href="../assets/img/favicon-32.png"><link rel="apple-touch-icon" href="../assets/img/apple-touch-icon.png">
<link rel="preload" href="../assets/fonts/ebgaramond-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="../assets/css/site.css">
<meta property="og:site_name" content="Cáirde Corrin"><meta property="og:locale" content="en_IE">
<meta property="og:image" content="https://www.cairdecorrin.ie/assets/img/og-default.jpg"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ T }}">
<meta name="twitter:description" content="{{ P.description }}"><meta name="twitter:image" content="https://www.cairdecorrin.ie/assets/img/og-default.jpg">
<script type="application/ld+json">
{{ pages | pageLd("recordings", page.url, figures) | safe }}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include "nav.njk" %}
<main id="main" class="page-head reading">
  <div class="wrap">
{{ pages | blocks("recordings", page.url, collections.gallery.length, instagram, social, figures) | safe }}
  </div>
  <div style="height:100px"></div>
</main>
<footer>
  <div class="wrap">
    <img src="../assets/img/logo-white.webp" alt="Cáirde Corrin" width="400" height="144" loading="lazy" decoding="async" style="height:46px;width:auto">
    {% include "footnav.njk" %}
    <div class="pillars"><span>Protect nature</span><span>Build community</span><span>Sustain the future</span></div>
    <p>Cáirde Corrin - Fermoy, Co. Cork - <a href="https://www.cairdecorrin.ie">cairdecorrin.ie</a></p>
    <p style="margin-top:14px">© 2026 Cáirde Corrin. Photography, audio and film by Cáirde Corrin. Third-party content is credited and licensed separately - see <a href="../credits/">Credits</a>.</p>
    <p style="margin-top:14px">Base mapping © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors (ODbL). <a href="../credits/">Sources and credits</a>.</p>
  </div>
</footer>
<script src="../assets/js/site.js" defer></script>
</body>
</html>
