<body>
<a class="skip" href="#main">Skip to content</a>
{% include "nav.njk" %}

<main id="main">
<!-- Scroll-driven film. Without JS, or where scrubbing is not viable, this stays a
     static poster with the three panels stacked; site.js adds .scrub only when a
     runtime probe shows the engine can actually seek at speed. -->
<section class="filmstrip on-dark" id="filmstrip">
  <div class="filmstrip-stage">
    <picture class="film-poster"><source media="(max-width:899px)" type="image/avif" srcset="assets/img/hero-poster-m720.avif 720w, assets/img/hero-poster-m1080.avif 1080w" sizes="100vw"><source media="(max-width:899px)" type="image/webp" srcset="assets/img/hero-poster-m720.webp 720w, assets/img/hero-poster-m1080.webp 1080w" sizes="100vw"><source type="image/avif" srcset="assets/img/hero-poster-700.avif 700w, assets/img/hero-poster-1100.avif 1100w, assets/img/hero-poster-1920.avif 1920w" sizes="100vw"><source type="image/webp" srcset="assets/img/hero-poster-700.webp 700w, assets/img/hero-poster-1100.webp 1100w, assets/img/hero-poster-1920.webp 1920w" sizes="100vw"><img src="assets/img/hero-poster-1920.webp" width="1920" height="1080" fetchpriority="high" decoding="async" alt="A shallow stony stream running over gravel and flat rock between wooded banks, bare branches on the left and green undergrowth on the right"></picture>
    <video id="herovideo" muted playsinline preload="none" aria-hidden="true" tabindex="-1"
           width="1920" height="1080" disablepictureinpicture disableremoteplayback>
      <source src="assets/video/hero-1920.mp4" type="video/mp4">
    </video>
    <div class="film-frames" id="filmframes" aria-hidden="true"><img id="filmframe" alt="" decoding="async"></div>
    <div class="film-scrim"></div>
    <div class="film-fade" aria-hidden="true"></div>
    <div class="film-panels">
      <div class="film-panel" data-at="0.10">
        <p class="film-strap">Cáirde Corrin</p>
        <h1>Glenabo<br><em>&amp; Corrin</em></h1>
        <p class="film-sub">{{ pages.home.p1 | prose | safe }}</p>
      </div>
      <div class="film-panel" data-at="0.40">
        <p class="film-line">{{ pages.home.p2 | prose | safe }}</p>
      </div>
      <div class="film-panel" data-at="0.75">
        <p class="film-line">{{ pages.home.p3 | prose | safe }}</p>
      </div>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="scroll-hint rv"><i></i> This page runs downhill</p>
    <p class="eyebrow rv">The ground we are talking about</p>
    <h2 class="rv">Everything that falls here<br>ends up in the Blackwater.</h2>
    <p class="rv">{{ pages.home.p4 | prose | safe }}</p>
    <dl class="figs rv">
      <div class="fig"><dt>Catchment area</dt><dd><small>about</small>3.6<small>km²</small></dd></div>
      <div class="fig"><dt>Or, in hectares</dt><dd><small>about</small>360<small>ha</small></dd></div>
      <div class="fig"><dt>Elevation range</dt><dd>21-213<small>m OD</small></dd></div>
      <div class="fig"><dt>Longest flow path</dt><dd><small>about</small>4<small>km</small></dd></div>
    </dl>
    <figure class="mapfig rv">
      <img src="assets/img/map-catchment-202611b-1800.webp" srcset="assets/img/map-catchment-202611b-1000.webp 1000w, assets/img/map-catchment-202611b-1800.webp 1800w" sizes="(min-width:1200px) 1136px, (min-width:901px) calc(100vw - 64px), calc(100vw - 44px)" width="1800" height="1547" loading="lazy" decoding="async" alt="Map of the Glenabo hydrological catchment showing boundary, modelled channel network and outlet to the Munster Blackwater">
      <figcaption>The Glenabo hydrological catchment, its modelled channel network, and the outlet to the Munster Blackwater.</figcaption>
    </figure>
  </div>
</section>

<!-- The argument of the whole project: two photographs 136 metres apart on one slope,
     twelve minutes apart, and completely different woodland. Shown together rather than in sequence. -->
<section class="plain compare">
  <div class="wrap">
    <p class="eyebrow rv">Two photographs, twelve minutes apart</p>
    <h2 class="rv">Same hill.<br>Same morning.</h2>
    <p class="rv">{{ pages.home.p5 | prose | safe }}</p>
    <div class="pair">
      <figure class="pair-item rv">
        <picture><source type="image/avif" srcset="assets/img/open-broadleaf-700.avif 700w, assets/img/open-broadleaf-1100.avif 1100w, assets/img/open-broadleaf-1800.avif 1800w" sizes="(min-width:840px) 46vw, calc(100vw - 44px)"><source type="image/webp" srcset="assets/img/open-broadleaf-700.webp 700w, assets/img/open-broadleaf-1100.webp 1100w, assets/img/open-broadleaf-1800.webp 1800w" sizes="(min-width:840px) 46vw, calc(100vw - 44px)"><img src="assets/img/open-broadleaf-1100.webp" width="1800" height="2397" loading="lazy" decoding="async" alt="Widely spaced slim broadleaf trunks with a thick green grass and herb layer covering the ground"></picture>
        <figcaption>
          <span class="pair-meta">about 80 m OD - 11 April 2026, 07:54</span>
          <span class="pair-line">Broadleaf, widely spaced. Light reaches the floor and the ground is green.</span>
        </figcaption>
      </figure>
      <figure class="pair-item rv">
        <picture><source type="image/avif" srcset="assets/img/dense-conifer-700.avif 700w, assets/img/dense-conifer-1100.avif 1100w, assets/img/dense-conifer-1800.avif 1800w" sizes="(min-width:840px) 46vw, calc(100vw - 44px)"><source type="image/webp" srcset="assets/img/dense-conifer-700.webp 700w, assets/img/dense-conifer-1100.webp 1100w, assets/img/dense-conifer-1800.webp 1800w" sizes="(min-width:840px) 46vw, calc(100vw - 44px)"><img src="assets/img/dense-conifer-1100.webp" width="1800" height="2397" loading="lazy" decoding="async" alt="Closely spaced straight conifer trunks above a floor of bare brown needle litter, ivy at the lower edge"></picture>
        <figcaption>
          <span class="pair-meta">about 90 m OD - 11 April 2026, 08:07</span>
          <span class="pair-line">Even-aged conifer, planted close. The floor is bare needle litter.</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <p class="eyebrow rv">About 21 m OD - the outlet</p>
    <h2 class="rv">One point on the <em class="hy">Blackwater</em>.</h2>
    <p class="rv">{{ pages.home.p6 | prose | safe }}</p>
    <p class="rv">{{ pages.home.p7 | prose | safe }}</p>
  </div>
</section>

<section class="plain">
  <div class="wrap">
    <p class="eyebrow rv">The wider picture</p>
    <h2 class="rv">Catchment, woodland and amenity<br>inside one working boundary.</h2>
    <p class="rv">{{ pages.home.p8 | prose | safe }}</p>
    <dl class="figs light rv">
      <div class="fig"><dt>Proposed action area</dt><dd>9.9<small>km²</small></dd></div>
      <div class="fig"><dt>Or, in hectares</dt><dd><small>about</small>990<small>ha</small></dd></div>
      <div class="fig"><dt>Of which catchment</dt><dd><small>about</small>3.6<small>km²</small></dd></div>
      <div class="fig"><dt>Proposed loop route</dt><dd>~15<small>km</small></dd></div>
    </dl>
    <figure class="mapfig rv">
      <img src="assets/img/map-action-202611b-1800.webp" srcset="assets/img/map-action-202611b-1000.webp 1000w, assets/img/map-action-202611b-1800.webp 1800w" sizes="(min-width:1200px) 1136px, (min-width:901px) calc(100vw - 64px), calc(100vw - 44px)" width="1800" height="1549" loading="lazy" decoding="async" alt="Map of the proposed area for action around Glenabo, Corrin Hill and Knockananig Reservoir">
      <figcaption>The proposed area for action, taking in the Glenabo catchment, Glenabo Wood, Corrin Hill and Knockananig Reservoir.</figcaption>
    </figure>
    <a class="cta" href="trails/">Explore the interactive map</a>
  </div>
</section>

<section class="plain tint">
  <div class="wrap">
    <p class="eyebrow rv">Strands of our Work</p>
    <h2 class="rv">The three strands of our work are</h2>
    <p class="rv">{{ pages.home.p9 | prose | safe }}</p>
    <div class="strands">
      <div class="strand rv"><div class="strand-n">Strand 1</div><div><h3>Points of interest</h3>
        <p>{{ pages.home.p10 | prose | safe }}</p>
        <a href="trails/">See the trail →</a></div></div>
      <div class="strand rv"><div class="strand-n">Strand 2</div><div><h3>New spaces</h3>
        <p>{{ pages.home.p11 | prose | safe }}</p>
        <a href="new-spaces/">What we are working on →</a></div></div>
      <div class="strand rv"><div class="strand-n">Strand 3</div><div><h3>Improving water and ecosystems</h3>
        <p>{{ pages.home.p12 | prose | safe }}</p>
        <a href="water/">How to help →</a></div></div>
    </div>
  </div>
</section>

<section class="plain gallery">
  <div class="wrap">
    <p class="eyebrow rv">From inside the catchment</p>
