<!DOCTYPE html>
<html lang="en-IE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>
// Netlify's default news-editor emails link here, to the site root, with the token in the
// address after the #. This hands that address to the editor's login page unchanged. It
// reads the address only: it loads nothing, sends nothing and stores nothing.
if (/^#(invite|recovery|email_change)_token=/.test(location.hash)) location.replace('admin/' + location.hash);
</script>
<title>Cáirde Corrin - caring for land, connecting community</title>
<meta name="description" content="A community group protecting, restoring and celebrating the Glenabo-Corrin catchment above Fermoy, Co. Cork.">
<link rel="canonical" href="https://www.cairdecorrin.ie/">
<meta property="og:title" content="Cáirde Corrin - caring for land, connecting community"><meta property="og:description" content="A community group protecting, restoring and celebrating the Glenabo-Corrin catchment above Fermoy, Co. Cork.">
<meta property="og:type" content="website"><meta property="og:url" content="https://www.cairdecorrin.ie/">
<link rel="icon" type="image/png" sizes="32x32" href="assets/img/favicon-32.png"><link rel="apple-touch-icon" href="assets/img/apple-touch-icon.png">
<!-- The film's text is set in these three faces. Fetched with the stylesheet rather than after
     it, they arrive before the first frame, so the text does not re-flow when they swap in. -->
<link rel="preload" href="assets/fonts/ebgaramond-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="assets/fonts/ebgaramond-italic.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="assets/fonts/plexmono-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="assets/css/site.css">
<meta property="og:site_name" content="Cáirde Corrin"><meta property="og:locale" content="en_IE">
<meta property="og:image" content="https://www.cairdecorrin.ie/assets/img/og-default.jpg"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="Cáirde Corrin - caring for land, connecting community">
<meta name="twitter:description" content="A community group protecting, restoring and celebrating the Glenabo-Corrin catchment above Fermoy, Co. Cork."><meta name="twitter:image" content="https://www.cairdecorrin.ie/assets/img/og-default.jpg">
