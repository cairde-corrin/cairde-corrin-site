{% if instagram.posts.length %}<section class="plain gallery">
  <div class="wrap">
    <p class="eyebrow rv">Elsewhere</p>
    <h2 class="rv">Recent posts<br>from the group.</h2>
  </div>
  <div class="carousel ig rv">
    <div class="car-head">
      <button class="car-btn car-prev" type="button" aria-label="Scroll Instagram posts left">←</button>
      <button class="car-btn car-next" type="button" aria-label="Scroll Instagram posts right">→</button>
    </div>
    <div class="car-scroll" tabindex="0" role="region" aria-label="Recent Instagram posts from Cáirde Corrin, scrollable">
      <ul class="car-track">
{%- for p in instagram.posts %}
        <li class="car-item"><a class="ig-post" href="{{ p.permalink }}">
          <figure>
            <picture><img src="{{ p.src | rel('') }}" srcset="{{ p.srcset | replace('/assets/', 'assets/') }}" sizes="(min-width:900px) 400px, 74vw" width="{{ p.width }}" height="{{ p.height }}" loading="lazy" decoding="async" alt=""></picture>
            <figcaption><span class="car-meta">Instagram - {{ p.date | longDate }}</span>{% if p.caption %} <span class="ig-cap">{{ p.caption }}</span>{% endif %}</figcaption>
          </figure>
        </a></li>
{%- endfor %}
      </ul>
    </div>
  </div>
{% if instagram.username %}  <div class="wrap" style="margin-top:36px"><a class="cta rv" href="https://www.instagram.com/{{ instagram.username }}/">Follow @{{ instagram.username }} on Instagram</a></div>
{% endif %}</section>

{% else %}{% set posts = social | socialPosts %}{% if posts.length %}<section class="plain">
  <div class="wrap">
    <p class="eyebrow rv">Elsewhere</p>
    <h2 class="rv">Recent posts<br>from the group.</h2>
    <div class="cards">
{%- for p in posts %}
      <article class="card rv"><p class="k">{{ p.platform }}</p><p>{{ p.caption }}</p><a class="card-link" href="{{ p.url }}" aria-label="View on {{ p.platform }}: {{ p.caption }}">View on {{ p.platform }}</a></article>
{%- endfor %}
    </div>
  </div>
</section>

{% endif %}{% endif %}<section class="plain">
  <div class="wrap">
    <p class="eyebrow rv">Get involved</p>
    <h2 class="rv">It is a small catchment.<br>That is the good news.</h2>
    <p class="rv">{{ pages.home.p14 | prose | safe }}</p>
    <a class="cta rv" href="about/">Join Cáirde Corrin</a>
  </div>
</section>
</main>
<footer>
