{#- Stop 02. Until the top of its page is filled in, in the editor (site/_data/pages/stop_2.json),
    it shows "Not yet surveyed", is kept out of search engines and the sitemap, and the trails page lists
    it as to be surveyed. Once it has content, its title, summary and structured data come from its
    "About this page" fields and its content from its blocks (_includes/blocks.js). -#}
{%- set D = pages.stop_2 -%}{%- set live = D.hero and D.hero.title -%}
{%- set T = ("Stop 02 - " + D.page.title + " - Cáirde Corrin") if live else "Stop 02 - Cáirde Corrin" -%}
{%- set DESC = D.page.description if live else "Reserved interpretation stop, not yet surveyed." -%}
<!DOCTYPE html>
<html lang="en-IE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ T }}</title>
<meta name="description" content="{{ DESC }}">
<link rel="canonical" href="https://www.cairdecorrin.ie/stops/stop-2.html">
<meta property="og:title" content="{{ T }}"><meta property="og:description" content="{{ DESC }}">
<meta property="og:type" content="website"><meta property="og:url" content="https://www.cairdecorrin.ie/stops/stop-2.html">
<link rel="icon" type="image/png" sizes="32x32" href="../assets/img/favicon-32.png"><link rel="apple-touch-icon" href="../assets/img/apple-touch-icon.png">
<link rel="preload" href="../assets/fonts/ebgaramond-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="../assets/css/site.css">
<meta property="og:site_name" content="Cáirde Corrin"><meta property="og:locale" content="en_IE">
<meta property="og:image" content="https://www.cairdecorrin.ie/assets/img/og-stop-2.jpg"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ T }}">
<meta name="twitter:description" content="{{ DESC }}"><meta name="twitter:image" content="https://www.cairdecorrin.ie/assets/img/og-stop-2.jpg">
{%- if not live %}
<meta name="robots" content="noindex, follow">
{%- endif %}
<script type="application/ld+json">
{{ pages | pageLd("stop_2", page.url, figures) | safe }}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include "nav.njk" %}
<main id="main" class="page-head{% if not live %} reading{% endif %}">
  <div class="wrap">
{{ pages | blocks("stop_2", page.url, collections.gallery.length, instagram, social, figures) | safe }}
  </div>
  <div style="height:100px"></div>
</main>
<footer>
  <div class="wrap">
    <img src="../assets/img/logo-white.webp" alt="Cáirde Corrin" width="400" height="144" loading="lazy" decoding="async" style="height:46px;width:auto">
    {% include "footnav.njk" %}
    <div class="pillars"><span>Protect nature</span><span>Build community</span><span>Sustain the future</span></div>
    <p>Cáirde Corrin - Fermoy, Co. Cork - <a href="https://www.cairdecorrin.ie">cairdecorrin.ie</a></p>
    <p style="margin-top:14px">© 2026 Cáirde Corrin. Photography, audio and film by Cáirde Corrin. Third-party content is credited and licensed separately - see <a href="../credits/">Credits</a>.</p>
    <p style="margin-top:14px">Base mapping © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors (ODbL). <a href="../credits/">Sources and credits</a>.</p>
  </div>
</footer>

<script src="../assets/js/site.js" defer></script>
</body>
</html>
