{%- set r = page.url | root -%}
{%- set site = "https://www.cairdecorrin.ie" -%}
{%- set fullTitle = title + " - Cáirde Corrin" -%}
{%- set og = hero.og if hero and hero.og else (hero if hero and hero.src else none) -%}
{%- set ogImage = (site + og.src) if og else (site + "/assets/img/og-default.jpg") -%}
<!DOCTYPE html>
<html lang="en-IE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ fullTitle }}</title>
<meta name="description" content="{{ description }}">
{%- if sample %}
<meta name="robots" content="noindex">
{%- elif section and not collections[section].length %}
{#- a section with nothing in it yet: built, so old links work, but not for search engines (_includes/nav.js) #}
<meta name="robots" content="noindex, follow">
{%- endif %}
<link rel="canonical" href="{{ site }}{{ page.url }}">
<meta property="og:title" content="{{ fullTitle }}"><meta property="og:description" content="{{ description }}">
<meta property="og:type" content="{{ ogType or 'website' }}"><meta property="og:url" content="{{ site }}{{ page.url }}">
<link rel="icon" type="image/png" sizes="32x32" href="{{ r }}assets/img/favicon-32.png"><link rel="apple-touch-icon" href="{{ r }}assets/img/apple-touch-icon.png">
<link rel="preload" href="{{ r }}assets/fonts/ebgaramond-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="{{ r }}assets/css/site.css">
<meta property="og:site_name" content="Cáirde Corrin"><meta property="og:locale" content="en_IE">
<meta property="og:image" content="{{ ogImage }}">
{%- if not og %}<meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
{%- elif og.width and og.height %}<meta property="og:image:width" content="{{ og.width }}"><meta property="og:image:height" content="{{ og.height }}">{% endif %}
<meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="{{ fullTitle }}">
<meta name="twitter:description" content="{{ description }}"><meta name="twitter:image" content="{{ ogImage }}">
<script type="application/ld+json">
{{ ld | dump(1) | safe }}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
{% include "nav.njk" %}
<main id="main" class="page-head reading">
  <div class="wrap">
{{ content | safe }}
  </div>
  <div style="height:100px"></div>
</main>
<footer>
  <div class="wrap">
    <img src="{{ r }}assets/img/logo-white.webp" alt="Cáirde Corrin" width="400" height="144" loading="lazy" decoding="async" style="height:46px;width:auto">
    {% include "footnav.njk" %}
    <div class="pillars"><span>Protect nature</span><span>Build community</span><span>Sustain the future</span></div>
    <p>Cáirde Corrin - Fermoy, Co. Cork - <a href="https://www.cairdecorrin.ie">cairdecorrin.ie</a></p>
    <p style="margin-top:14px">© 2026 Cáirde Corrin. Photography, audio and film by Cáirde Corrin. Third-party content is credited and licensed separately - see <a href="{{ r }}credits/">Credits</a>.</p>
    <p style="margin-top:14px">Base mapping © <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors (ODbL). <a href="{{ r }}credits/">Sources and credits</a>.</p>
  </div>
</footer>

<script src="{{ r }}assets/js/site.js" defer></script>
</body>
</html>
