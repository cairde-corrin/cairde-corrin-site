{#- The header, from _includes/nav.js. Included by every page. -#}
{%- set r = page.url | root -%}
<script>document.documentElement.classList.add('js')</script>
<header class="nav" id="nav">
  <a class="brand" href="{{ r or './' }}">
    <img class="logo-c" src="{{ r }}assets/img/logo.webp" alt="Cáirde Corrin" width="400" height="144">
    <img class="logo-w" src="{{ r }}assets/img/logo-white.webp" alt="Cáirde Corrin" width="400" height="144">
  </a>
  <button class="navtoggle" id="navtoggle" aria-expanded="false" aria-controls="navlinks">Menu</button>
  <noscript><a class="navtoggle" href="#site-links">Menu</a></noscript>
  <nav class="navlinks" id="navlinks" aria-label="Main"><ul class="navlist">
{%- for g in page.url | navItems(collections.gallery.length, collections.articles.length) %}
{%- if g.items %}
    <li class="grp"><button class="n navgrp{% if g.current %} cur{% endif %}" type="button" aria-expanded="false" aria-controls="nav-{{ g.id }}">{{ g.label }}</button><ul class="sub" id="nav-{{ g.id }}">
{%- for i in g.items %}<li><a class="n" href="{{ r }}{{ i.href }}"{% if i.current %} aria-current="page"{% endif %}>{{ i.label }}</a></li>{% endfor -%}
</ul></li>
{%- else %}
    <li><a class="n" href="{{ r }}{{ g.href }}"{% if g.current %} aria-current="page"{% endif %}>{{ g.label }}</a></li>
{%- endif %}
{%- endfor %}
  </ul></nav>
</header>
{%- set edit = page | editLink %}{% if edit %}
<a class="editlink" href="{{ r }}admin/#/{{ edit }}" hidden>Edit this page</a>
{%- endif %}